{
  "name": "Performances ACBT",
  "short_name": "Performances",
  "description": "Calculateur de performances décollage/atterrissage",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#edf1f7",
  "theme_color": "#0e3070",
  "orientation": "any",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share-gpx",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "gpx",
          "accept": [
            "application/gpx+xml",
            ".gpx",
            "application/xml",
            "text/xml",
            "application/octet-stream"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "application/gpx+xml": [
          ".gpx"
        ]
      }
    }
  ]
}